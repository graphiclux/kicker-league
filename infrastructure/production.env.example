# Copy to repository root .env.production; generate distinct secrets.
NODE_ENV=production
DOMAIN=app.example.com
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
MIGRATION_DATABASE_URL=postgresql://aing_owner:OWNER_PASSWORD@postgres:5432/aing
DATABASE_URL=postgresql://aing_app:APP_PASSWORD@postgres:5432/aing
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
COOKIE_SECURE=true
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=no-reply@example.com
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=no-reply@example.com
# Season-level nflverse play-by-play feed; the API filters the requested week.
# Keep this provider configurable so it can be replaced by a licensed feed.
NFLVERSE_PBP_URL=https://github.com/nflverse/nflverse-data/releases/download/pbp/play_by_play_{season}.csv.gz
NFLVERSE_PLAYERS_URL=https://github.com/nflverse/nflverse-data/releases/download/players/players.csv
# Enable the 10-minute game-day loop by setting the current season and weeks.
NFL_AUTO_SYNC_INTERVAL_MINUTES=10
NFL_AUTO_SYNC_SEASON=
NFL_AUTO_SYNC_WEEKS=
EXPO_ACCESS_TOKEN=
AING_API_IMAGE=aing-api:latest
AING_WORKER_IMAGE=aing-worker:latest
AING_WEB_IMAGE=aing-web:latest
